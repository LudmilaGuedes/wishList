# Copie este arquivo para ".env" e preencha.

# Chave da SerpApi (https://serpapi.com) para buscar preços automaticamente no Google Shopping.
# Sem ela o site funciona, mas os preços são digitados manualmente.
SERPAPI_KEY=

# Senha para entrar no site (recomendado quando estiver na internet). Deixe vazio para não pedir senha.
APP_PASSWORD=

# Banco Postgres. Deixe vazio no seu computador: os dados ficam em data/db.json.
DATABASE_URL=

PORT=3000
